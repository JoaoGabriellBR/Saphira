# Copie para .env e preencha. NUNCA commite o .env.
ELEVENLABS_API_KEY=         # elevenlabs.io → Profile → API Key (STT Scribe)
TAVILY_API_KEY=             # app.tavily.com → API Keys
GEMINI_API_KEY=             # aistudio.google.com → API key (fallback LLM)

# Voz e TTS Kokoro
# KOKORO_VOICE=pf_dora       # Voz padrão pt-BR: pf_dora (outras: pm_alex, pm_santa)
# KOKORO_SPEED=1.0           # Velocidade da fala (float, ex: 1.0)

# Opcionais
# ANTHROPIC_API_KEY=        # console.anthropic.com → API Keys (sem ela o Gemini vira o provider principal)
# CLAUDE_MODEL=claude-sonnet-5
# SAPHIRA_HOTKEY=<f9>
# SAPHIRA_COMMANDS=commands.yaml
# ELEVENLABS_VOICE_ID=       # Legado / opcional caso realize rollback para ElevenLabs TTS

