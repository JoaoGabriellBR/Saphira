# Copie para .env e preencha. NUNCA commite o .env.
TAVILY_API_KEY=             # app.tavily.com → API Keys
GEMINI_API_KEY=             # aistudio.google.com → API key (fallback LLM)

# STT (faster-whisper local por padrão; ou elevenlabs)
# STT_PROVIDER=faster-whisper # faster-whisper | elevenlabs
# WHISPER_MODEL=large-v3-turbo # large-v3-turbo | medium | small | base | tiny
# WHISPER_DEVICE=auto       # auto | cuda | cpu
# WHISPER_COMPUTE_TYPE=auto # auto | float16 | int8

# ElevenLabs (necessário apenas se STT_PROVIDER=elevenlabs ou fallback de TTS legado)
# ELEVENLABS_API_KEY=       # elevenlabs.io → Profile → API Key

# Voz e TTS Kokoro
# KOKORO_VOICE=pf_dora       # Voz padrão pt-BR: pf_dora (outras: pm_alex, pm_santa)
# KOKORO_SPEED=1.0           # Velocidade da fala (float, ex: 1.0)

# Opcionais
# ANTHROPIC_API_KEY=        # console.anthropic.com → API Keys (sem ela o Gemini vira o provider principal)
# CLAUDE_MODEL=claude-sonnet-5
# SAPHIRA_HOTKEY=<f9>
# SAPHIRA_COMMANDS=commands.yaml
# ELEVENLABS_VOICE_ID=       # Legado / opcional caso realize rollback para ElevenLabs TTS


