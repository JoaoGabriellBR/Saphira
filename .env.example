# Copie para .env e preencha. NUNCA commite o .env.
ANTHROPIC_API_KEY=          # console.anthropic.com → API Keys
ELEVENLABS_API_KEY=         # elevenlabs.io → Profile → API Key
ELEVENLABS_VOICE_ID=        # elevenlabs.io → Voice Library → sua voz → ID
TAVILY_API_KEY=             # app.tavily.com → API Keys
GEMINI_API_KEY=             # aistudio.google.com → API key (fallback LLM)

